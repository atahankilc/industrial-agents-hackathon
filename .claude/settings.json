{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-verification.py\"",
            "timeout": 15,
            "statusMessage": "Checking commit verification stamp"
          }
        ]
      }
    ]
  }
}
