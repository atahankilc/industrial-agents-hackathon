{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend/",
      "framework": "vite"
    },
    "api": {
      "root": "./",
      "framework": "fastapi",
      "entrypoint": "backend.api.app:app",
      "functions": {
        "backend/api/app.py": {
          "maxDuration": 300,
          "excludeFiles": "{package.json,.claude/**,.idea/**,archive/**,docs/**,frontend/**,memory-bank/**,scripts/**,supabase/**,tests/**,agent_output/**,*.pdf,data/**/*.png,data/**/*.svg,data/**/*.jsonl,data/**/equipment.csv}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
