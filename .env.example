# Copy to .env (git-ignored) and fill in. Never commit .env; never paste keys into chat or code.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Optional: question parser (see agent/parsing.py)
PARSER_MODE=hybrid
# Supabase (docs/research/stack-options.md#6-env-vars--secrets). Project Settings → API Keys / Connect.
SUPABASE_URL=
# Publishable (anon) key: public, safe for the frontend.
SUPABASE_ANON_KEY=
# Secret (service_role) key: backend only, never in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Connect → Transaction pooler URI (port 6543), with your DB password filled in (URL-encode special characters).
SUPABASE_DB_URL=
